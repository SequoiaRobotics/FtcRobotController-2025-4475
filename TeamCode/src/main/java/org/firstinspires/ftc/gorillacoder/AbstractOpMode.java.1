            public boolean liveView() {
                return streaming;
            }

            public synchronized VisionRunner liveView(boolean value) {
                liveView = value;
                if (value) {
                    portal.resumeLiveView();
                } else {
                    portal.stopLiveView();
                }

                return this;
            }

            private AprilTagDetections detections;

            private AprilTagProcessor processor;

            private volatile boolean streaming = false;

            private volatile boolean liveView = false;

            private boolean running = false;

            private boolean stopped = true;

            private VisionPortal portal;

            private long RUN_FREQUENCY_MILLIS = 100;

        } // class VisionRunner

        @Override
        public VisionTask start() {
            visionThread.start();
            RobotLog.ii(GORILLA_CORE, "VisionTask.start(), visionThread started: state=%s", visionThread.getState());

            return this;
        }

        @Override
        public VisionTask init() {
            RobotLog.ii(GORILLA_CORE, "VisionTask.init(), start");

            // Run once per second.
            // This task doesn't really do anything. It's all done by the runner.
            // This task is just a wrapper to hide the runner, and forward calls to it.
            // Heck, we could probably run this once an hour and all would be fine.
            this.frequencyMillis( SECONDS.toMillis(1) );
            // When no quick tasks are running, then we have to run quick cause otherwise we'll stall
            // in loop() for so long waiting on this task to run, that we'll delay too long and
            // stop won't get processed in a timely fashion and then RobotCore will kill us.
            this.frequencyMillis(50);

            visionRunner.init();

            RobotLog.ii(GORILLA_CORE, "VisionTask.init(), done");
            telemetry.log().add("VisionTask.init(), done");
            telemetry.update();
            return this;
        }

        public VisionTask stop() {
            visionRunner.stop();

            return this;
        }

        public synchronized AprilTagDetections detections() {
            return visionRunner.detections();
        }
        public VisionTask cameraLeft(WebcamName value) {
            cameraLeft = value;

            return this;
        }

        public VisionTask cameraRight(WebcamName value) {
            cameraRight = value;

            return this;
        }

        public boolean streaming() {
            return visionRunner.streaming();
        }

        public synchronized VisionTask streaming(boolean value) {
            visionRunner.streaming(value);

            return this;
        }
        VisionRunner visionRunner = new VisionRunner();

        Thread visionThread = new Thread(visionRunner);

        WebcamName     cameraLeft;

        WebcamName     cameraRight;
    } // class VisionTask

