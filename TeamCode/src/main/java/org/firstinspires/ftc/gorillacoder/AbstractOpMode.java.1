    abstract class AbstractDriveTask extends AbstractOpModeTask<OpModeT> {

        public AbstractDriveTask init() {
            driveRightFront.setDirection(DcMotorSimple.Direction.REVERSE);
            driveRightRear.setDirection(DcMotorSimple.Direction.REVERSE);
            driveLeftFront.setDirection(DcMotorSimple.Direction.FORWARD);
            driveLeftRear.setDirection(DcMotorSimple.Direction.FORWARD);

            return this;
        }

        public AbstractDriveTask driveLeftRear(DcMotorEx value) {
            driveLeftRear = value;

            return this;
        }

        public AbstractDriveTask driveRightRear(DcMotorEx value) {
            driveRightRear = value;

            return this;
        }

        public AbstractDriveTask driveLeftFront(DcMotorEx value) {
            driveLeftFront = value;

            return this;
        }

        public AbstractDriveTask driveRightFront(DcMotorEx value) {
            driveRightFront = value;

            return this;
        }

        DcMotorEx driveLeftRear;

        DcMotorEx driveRightRear;

        DcMotorEx driveLeftFront;

        DcMotorEx driveRightFront;

    } // abstract class AbstractDriveTask

    class DrivePovTask extends AbstractDriveTask {
        @Override
        public DrivePovTask run() {
            double leftPower = Range.clip(driveSpeed - driveTurn, -1.0, 1.0);
            double rightPower = Range.clip(driveSpeed + driveTurn, -1.0, 1.0);

            RobotLog.ii(GORILLA_CORE, "%s.run() start: left:%f right:%f", getClass().getSimpleName(), leftPower, rightPower);

            // Send calculated power to wheels
            driveLeftRear.setPower(leftPower);
            driveLeftFront.setPower(leftPower);
            driveRightRear.setPower(rightPower);
            driveRightFront.setPower(rightPower);

            // Show the elapsed game time and wheel power.
            RobotLog.ii(GORILLA_CORE, "Status", "Run Time: " + runtime);
            RobotLog.ii(GORILLA_CORE, "Motors", "left (%.2f), right (%.2f)", leftPower, rightPower);

            RobotLog.ii(GORILLA_CORE, "%s.run() done: left:%f right:%f", getClass().getSimpleName(), leftPower, rightPower);
            return this;
        }

        @Override
        public DrivePovTask init() {
            RobotLog.ii(GORILLA_CORE, "DrivePovTask init: start");
            super.init();
            this.frequencyMillis(10); // adjust motors every 10ms, 100/second
            RobotLog.ii(GORILLA_CORE, "DrivePovTask init: done");
            return this;
        }
    } // class DrivePovTask

    // Tank Mode uses one stick to control each wheel.
    class DriveTankTask extends AbstractDriveTask {
        @Override
        public DriveTankTask run() {
            // Send calculated power to wheels
            driveLeftRear.setPower(driveLeftPower);
            driveLeftFront.setPower(driveLeftPower);
            driveRightRear.setPower(driveRightPower);
            driveRightFront.setPower(driveRightPower);

            // Show the elapsed game time and wheel power.
            telemetry.addData("Status", "Run Time: " + runtime);
            telemetry.addData("Motors", "left (%.2f), right (%.2f)", driveLeftPower, driveRightPower);

            return this;
        }

        @Override
        public DriveTankTask init() {
            super.init();
            this.frequencyMillis(10); // adjust motors every 10ms, 100/second
            return this;
        }
    } // class DriveTankTask

